# ============================================================================
# QualityApp Backend Environment Configuration
# ============================================================================

# Server Port
PORT=4000
NODE_ENV=development

# ----------------------------------------------------------------------------
# PostgreSQL Database Configuration
# ----------------------------------------------------------------------------
# Option A: Full Connection URL (Recommended)
# Replace YOUR_PASSWORD with your Windows PostgreSQL user password.
# Development database name is 'qualityapp_db' (never use or modify 'newDB').
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/qualityapp_db

# Option B: Individual Connection Parameters (used if DATABASE_URL is not set)
PGHOST=localhost
PGPORT=5432
PGDATABASE=qualityapp_db
PGUSER=postgres
PGPASSWORD=YOUR_PASSWORD
PGSSLMODE=disable

# Connection Pool Tuning
PG_POOL_MAX=20
PG_IDLE_TIMEOUT=30000
PG_CONN_TIMEOUT=5000

# ----------------------------------------------------------------------------
# Google Drive Backup Configuration (Optional)
# ----------------------------------------------------------------------------
GOOGLE_DRIVE_BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=6
BACKUP_RETENTION_ENABLED=false
BACKUP_RETENTION_DAYS=30

# Target Google Drive Folder (optional, folder named 'Backups' used if blank)
GOOGLE_DRIVE_FOLDER_ID=

# Option A: Google Account OAuth2 (Recommended - uses your personal Google account)
# 1. Go to https://console.cloud.google.com/apis/credentials
# 2. Create OAuth 2.0 Client ID (Web application)
# 3. Add http://localhost:4000/api/auth/google/callback as Authorized redirect URI
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:4000/api/auth/google/callback

# Option B: Service Account (alternative)
# GOOGLE_SERVICE_ACCOUNT_CRED_FILE=C:/path/to/service-account.json
GOOGLE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_SERVICE_ACCOUNT_PRIVATE_KEY=
